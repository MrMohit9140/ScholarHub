<% layout("/layouts/boilerplate") %>

<div class="scholarship-page">

    <div class="scholarship-header">

        <p class="eyebrow">
            SCHOLARHUB
        </p>

        <h1>Find Scholarships That Match You</h1>

        <p>
            Tell us about yourself and we will find scholarship
            opportunities that match your profile.
        </p>

    </div>


    <form
        action="/scholarships/find"
        method="POST"
        class="scholarship-form"
    >

        <div class="form-group">
            <label>Gender</label>

            <select name="gender">
                <option value="">Select Gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
            </select>
        </div>


        <div class="form-group">
            <label>State</label>

            <input
                type="text"
                name="state"
                placeholder="Enter your state"
                required
            >
        </div>


        <div class="form-group">
            <label>District</label>

            <input
                type="text"
                name="district"
                placeholder="Enter your district"
            >
        </div>


        <div class="form-group">
            <label>Education Level</label>

            <select name="educationLevel" required>
                <option value="">Select</option>
                <option value="School">School</option>
                <option value="Diploma">Diploma</option>
                <option value="Undergraduate">Undergraduate</option>
                <option value="Postgraduate">Postgraduate</option>
            </select>
        </div>


        <div class="form-group">
            <label>Institution</label>

            <input
                type="text"
                name="institution"
                placeholder="College / School"
            >
        </div>


        <div class="form-group">
            <label>Course</label>

            <input
                type="text"
                name="course"
                placeholder="Example: B.Tech"
            >
        </div>


        <div class="form-group">
            <label>Current Year</label>

            <select name="year">
                <option value="">Select Year</option>
                <option value="1">1st Year</option>
                <option value="2">2nd Year</option>
                <option value="3">3rd Year</option>
                <option value="4">4th Year</option>
            </select>
        </div>


        <div class="form-group">
            <label>Annual Family Income</label>

            <input
                type="number"
                name="annualIncome"
                placeholder="Example: 300000"
                required
            >
        </div>


        <div class="form-group">
            <label>Category</label>

            <select name="category">
                <option value="">Select Category</option>
                <option value="General">General</option>
                <option value="OBC">OBC</option>
                <option value="SC">SC</option>
                <option value="ST">ST</option>
                <option value="EWS">EWS</option>
            </select>
        </div>


        <div class="form-group">
            <label>Percentage / CGPA Equivalent</label>

            <input
                type="number"
                name="percentage"
                step="0.01"
                placeholder="Example: 82.5"
            >
        </div>


        <div class="checkbox-group">

            <label>
                <input type="checkbox" name="disability">
                I have a disability
            </label>

            <label>
                <input type="checkbox" name="firstGeneration">
                I am a first-generation student
            </label>

            <label>
                <input type="checkbox" name="hosteller">
                I am a hosteller
            </label>

        </div>


        <button type="submit">
            Find Scholarships
        </button>

    </form>

</div>