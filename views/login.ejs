
    <!-- navBar Section -->
     <% layout("/layouts/boilerplate") %>


    <!-- ================= PAGE ================= -->

    <main class="page">


        <!-- ================= LEFT PANEL ================= -->

        <section class="intro-panel">

            <div class="intro-content">


                <!-- BRAND -->

                <div class="brand-badge">
                    ✦ ScholarHub
                </div>


                <!-- HEADING -->

                <h1>
                    Welcome
                    <span>back.</span>
                </h1>


                <p class="intro-text">

                    Continue your journey with ScholarHub.
                    Discover opportunities, connect with students,
                    and make your next step count.

                </p>


                <!-- BENEFITS -->

                <div class="benefits">


                    <div class="benefit">

                        <div class="benefit-icon">
                            🎓
                        </div>

                        <div>

                            <h3>
                                Discover Opportunities
                            </h3>

                            <p>
                                Find scholarships, internships,
                                programs and more.
                            </p>

                        </div>

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">
                            🚀
                        </div>

                        <div>

                            <h3>
                                Keep Growing
                            </h3>

                            <p>
                                Stay connected with opportunities
                                that match your journey.
                            </p>

                        </div>

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">
                            🤝
                        </div>

                        <div>

                            <h3>
                                Be Part of the Community
                            </h3>

                            <p>
                                Connect and learn with students
                                from different backgrounds.
                            </p>

                        </div>

                    </div>


                </div>


                <!-- QUOTE -->

                <div class="quote-card">

                    <span class="quote-mark">
                        “
                    </span>

                    <p>
                        Every opportunity starts with taking
                        the first step.
                    </p>

                    <small>
                        — ScholarHub
                    </small>

                </div>


            </div>

        </section>



        <!-- ================= LOGIN PANEL ================= -->

        <section class="form-panel">


            <div class="form-container">


                <!-- FORM HEADING -->

                <div class="form-heading">

                    <p class="form-label">
                        WELCOME BACK
                    </p>

                    <h2>
                        Login to ScholarHub
                    </h2>

                    <p>
                        Enter your details to continue.
                    </p>

                </div>



                <!-- ================= LOGIN FORM ================= -->

                <form
                    method="POST"
                    action="/home/login"
                    id="loginForm"
                >


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label for="email">
                            Email Address
                            <span>*</span>
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="you@example.com"
                            autocomplete="email"
                            required
                        >

                    </div>



                    <!-- PASSWORD -->

                    <div class="form-group">

                        <div class="label-row">

                            <label for="password">
                                Password
                                <span>*</span>
                            </label>

                            <a
                                href="/home/forgot-password"
                                class="forgot-password"
                            >
                                Forgot password?
                            </a>

                        </div>


                        <div class="password-wrapper">

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Enter your password"
                                autocomplete="current-password"
                                required
                            >

                            <button
                                type="button"
                                class="password-toggle"
                                id="togglePassword"
                                aria-label="Show password"
                            >
                                Show
                            </button>

                        </div>

                    </div>



                    <!-- REMEMBER ME -->

                    <label class="remember-me">

                        <input
                            type="checkbox"
                            name="remember"
                        >

                        <span>
                            Keep me signed in
                        </span>

                    </label>



                    <!-- LOGIN BUTTON -->

                    <button
                        type="submit"
                        class="submit-btn"
                    >

                        <span>
                            Login to ScholarHub
                        </span>

                        <span class="arrow">
                            →
                        </span>

                    </button>



                    <!-- REGISTER LINK -->

                    <p class="form-footer">

                        Don't have an account?

                        <a href="/home/register">
                            Create an account
                        </a>

                    </p>


                </form>


            </div>

        </section>


    </main>



   