    <!-- ================= COMMUNITY ================= -->

    <section class="section community-section">

        <div class="section-container">


            <div class="section-heading">

                <p class="small-heading">
                    COMMUNITY
                </p>

                <h2>
                    Meet the ScholarHub Community
                </h2>

                <p>
                    Discover students, explore profiles and
                    connect with people on a similar journey.
                </p>

            </div>


            <!-- SEARCH -->

            <div class="search-box">

                <span class="search-icon">
                    ⌕
                </span>

                <input
                    type="text"
                    id="searchInput"
                    placeholder="Search users..."
                >

            </div>


            <!-- USER GRID -->

            <section
                class="user-grid"
                id="userGrid"
            >

                <% if (typeof users !== "undefined" && users.length > 0) { %>


                    <% for (let user of users.slice(0, 6)) { %>

                        <div
                            class="user-card"
                            data-username="<%= user.username.toLowerCase() %>"
                            data-name="<%= user.name.toLowerCase() %>"
                        >

                            <div class="card-top">

                                <div class="avatar">

                                    <%= user.username
                                        .charAt(0)
                                        .toUpperCase()
                                    %>

                                </div>

                                <div class="online-dot"></div>

                            </div>


                            <div class="user-content">

                                <h2>
                                    <%= user.name %>
                                </h2>

                                <p class="username">
                                    @<%= user.username %>
                                </p>

                                <p class="bio">
                                    <%= user.bio %>
                                </p>


                                <a
                                    href="/post/<%= user.id %>"
                                    class="profile-btn"
                                >
                                    View Profile →
                                </a>

                            </div>

                        </div>

                    <% } %>


                <% } else { %>

                    <div class="empty-community">

                        <h3>
                            No community members yet
                        </h3>

                        <p>
                            Be one of the first students
                            to join ScholarHub.
                        </p>

                        <a
                            href="/post/new"
                            class="primary-btn"
                        >
                            Create Profile
                        </a>

                    </div>

                <% } %>

            </section>


            <div
                id="noResults"
                class="no-results"
            >

                <h2>
                    No users found
                </h2>

                <p>
                    Try searching with another name
                    or username.
                </p>

            </div>


            <div class="community-action">

                <a
                    href="/posts"
                    class="primary-btn"
                >
                    View All Community Members →
                </a>

            </div>

        </div>

    </section>



    
        

    